# LLM Provider Configuration
AI_PROVIDER=Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=llama3.1:latest
OLLAMA_EMBEDDING_MODEL_ID=nomic-embed-text

# OpenAI (alternative provider)
# AI_PROVIDER=OpenAI
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL_ID=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL_ID=text-embedding-3-small

# Database Configuration
DATABASE_PATH=../data/ran.db  # Shared with .NET (relative to python/)
DATABASE_PROVIDER=Sqlite

# Vector Database Configuration (Optional)
VECTOR_DB_PROVIDER=Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=ran
QDRANT_TOP_K=5

# Web Search Configuration (Optional)
WEB_SEARCH_PROVIDER=TavilyApi
TAVILY_API_KEY=your-tavily-api-key
WEB_SEARCH_ALLOWLIST=arxiv.org,wikipedia.org
WEB_SEARCH_RPM=30
WEB_SEARCH_MIN_INTERVAL_MS=500

# Orchestrator Settings
MAX_CONCURRENCY=5
MAX_DECOMPOSITION_DEPTH=2
MAX_RETRIES=1
LOG_PROMPTS=true
ENABLE_WEB_SEARCH=false

# Task Merging Settings
MERGING_PENDING_THRESHOLD=0.9
MERGING_COMPLETED_THRESHOLD=0.95

# RAG Settings
RAG_STORE_MIN_CONFIDENCE=0.6
RAG_DUPLICATE_THRESHOLD=0.98

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_HOST=0.0.0.0
API_PORT=8090
API_RELOAD=true

# LangSmith Configuration (Optional - for tracing and debugging)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=research-agent-network
